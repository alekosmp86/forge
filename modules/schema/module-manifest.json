{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgeModuleManifest",
  "type": "object",
  "required": ["id", "name", "description", "version", "targets"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the module (e.g. 'notifications')"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the module"
    },
    "description": {
      "type": "string",
      "description": "Short explanation of module features"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["nexcore", "javacore", "vitacore"]
      }
    },
    "envVariables": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "schemaExtensions": {
      "type": "object",
      "properties": {
        "userFieldsPrisma": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Direct Prisma fields to patch into core model User"
        },
        "userFlywaySql": {
          "type": "array",
          "items": { "type": "string" },
          "description": "SQL ALTER TABLE commands to execute on users table"
        }
      }
    },
    "navigationItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href", "icon"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "icon": { "type": "string" },
          "badge": { "type": "string" }
        }
      }
    }
  }
}

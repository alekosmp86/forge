// ─── Prisma Schema — nexcore kernel ──────────────────────────────────────────
//
// This schema defines base kernel-level configurations.
// Feature modules (like auth, notifications) ADD their own models to this file
// when integrated via script installation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Module Models (added dynamically by feature modules) ───────────────────
